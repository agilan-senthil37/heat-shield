NEXT_PUBLIC_DATA_MODE=demo
# Set to live with the team API origin (without /api).
NEXT_PUBLIC_API_BASE_URL=

# Required for real email OTP. Configure the Supabase email template to include
# {{ .Token }} and use an SMTP provider that delivers to community users.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Use true behind a trusted TLS reverse proxy.
HEAT_SHIELD_HTTPS=false
# Absolute path on a persistent volume for a single community server.
# HEAT_SHIELD_DB=/absolute/path/heat-shield.sqlite
