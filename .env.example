# Demo is intentionally synthetic. Supabase is required for durable hosted storage.
DATA_MODE=demo
AI_MODE=template
# Used only in Supabase mode; publishable/anon key, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# AI_MODE=openai requires both values. Keep OPENAI_API_KEY server-side.
OPENAI_API_KEY=
OPENAI_MODEL=
# For production demo only: protect mutation/report routes with this bearer token.
# Do not put this shared token in browser bundles. Local demo needs no token.
DEMO_ACCESS_TOKEN=
# Optional local demo storage path (default .data/projects).
DEMO_STORAGE_DIR=
